# SuccessOS Configuration

# OpenAI (required)
OPENAI_API_KEY=sk-your-key-here

# Admin WhatsApp (optional - for crash notifications)
ADMIN_PHONE=5491112345678@s.whatsapp.net

# General
TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=info

# Database (optional - defaults shown)
DB_PATH=./data/successos.db
AUTH_DIR=./data/auth_info_baileys

# Backups
BACKUP_ROOT=/home/ubuntu/backups/successos
BACKUP_STATUS_FILE=/home/ubuntu/backups/successos/latest.json
BACKUP_REMOTE_MODE=none
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_PREFIX=prod
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=prod
BACKUP_LOCAL_DAILY_RETENTION=7
BACKUP_LOCAL_WEEKLY_RETENTION=4

# Timeouts (optional)
OPENAI_TIMEOUT_MS=30000
WHISPER_TIMEOUT_MS=60000

# API Server for PWA (optional)
API_PORT=3000
APP_BASE_URL=https://146-235-245-149.nip.io
JWT_SECRET=change-this-to-a-random-string
CORS_ORIGIN=*

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. If omitted, SuccessOS uses APP_BASE_URL + /api/calendar/callback
GOOGLE_REDIRECT_URI=

# AI behavior (optional)
CONTEXT_LIMIT=10
MESSAGE_COOLDOWN_MS=1500

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
